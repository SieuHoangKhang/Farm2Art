rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true; // Allow server-side API routes + authenticated users
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // User profiles - owner only
    match /user_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Listings - public read, authenticated write
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if true; // API routes (server-side) can update approval status
    }

    // Orders - read/write for buyer and seller
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true; // API route creates orders
      allow update: if true; // API route updates payment status
    }

    // Seller verifications
    match /seller_verifications/{sellerId} {
      allow read: if true;
      allow write: if true; // API route manages verification
    }

    // Wallets - owner only
    match /wallets/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Wallet transactions
    match /wallet_transactions/{txnId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Conversations
    match /conversations/{convId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Wishlist
    match /wishlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    // News
    match /news/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Seller Reviews
    match /seller_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Admin Chat Messages
    // NOTE: API routes currently use web Firestore SDK without Firebase Admin credentials,
    // so requests are unauthenticated at rules level.
    match /admin_chat_messages/{messageId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

  }
}
